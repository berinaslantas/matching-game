}
.column { width: 50%; }
.card {
  background: #161b22;
  padding: 14px;
  margin: 8px 0;
  border-radius: 10px;
  border: 1px solid #30363d;
  cursor: pointer;
  transition: 0.15s;
  color: #c9d1d9;
}
.card.selected { border-color: #58a6ff; }
.card.correct { color:#2ea043; }
.card.wrong { color:#ff7f0e; }
